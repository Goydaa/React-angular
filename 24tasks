// 17. Shape / Circle / Rectangle / Triangle

console.log("\n=== 17. Shape ===");
abstract class Shape {
  abstract area(): number;
  describe(): string {
    return `Площадь: ${this.area().toFixed(2)}`;
  }
}
class Circle extends Shape {
  constructor(private r: number) { super(); }
  area(): number { return Math.PI * this.r ** 2; }
}
class Rectangle extends Shape {
  constructor(private w: number, private h: number) { super(); }
  area(): number { return this.w * this.h; }
}
class Triangle extends Shape {
  constructor(private a: number, private b: number, private c: number) { super(); }
  area(): number {
    const p = (this.a + this.b + this.c) / 2;
    return Math.sqrt(p * (p - this.a) * (p - this.b) * (p - this.c));
  }
}
const shapes: Shape[] = [new Circle(5), new Rectangle(4, 6), new Triangle(3, 4, 5)];
shapes.forEach((s) => console.log(s.describe()));
const totalArea = shapes.reduce((sum, s) => sum + s.area(), 0);
console.log("Общая площадь:", totalArea.toFixed(2));


// 18. Serializable / Settings

console.log("\n=== 18. Serializable ===");
interface Serializable {
  serialize(): string;
  deserialize(data: string): void;
}
class Settings implements Serializable {
  private settings: Record<string, unknown> = {};
  serialize(): string { return JSON.stringify(this.settings); }
  deserialize(data: string): void { this.settings = JSON.parse(data); }
  set(key: string, value: unknown): void { this.settings[key] = value; }
}
const settings = new Settings();
settings.set("theme", "dark");
settings.set("fontSize", 14);
const serialized = settings.serialize();
console.log("Сериализовано:", serialized);
const restored = new Settings();
restored.deserialize(serialized);
console.log("Восстановлено:", restored.serialize());


