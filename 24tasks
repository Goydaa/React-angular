// 3. Массивы и sumMatrix

console.log("\n=== 3. sumMatrix ===");
const cities: string[] = ["Москва", "Питер", "Казань"];
const matrix: number[][] = [
  [1, 2, 3],
  [4, 5, 6],
  [7, 8, 9],
];
const emptyNums: number[] = [];

function sumMatrix(m: number[][]): number {
  let sum = 0;
  for (const row of m) for (const n of row) sum += n;
  return sum;
}
