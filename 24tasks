// 24. handle(res: Response)

console.log("\n=== 24. handle ===");
type ApiResponse =
  | { status: "success"; data: string[] }
  | { status: "error"; message: string }
  | { status: "loading" };

function handle(res: ApiResponse): string {
  switch (res.status) {
    case "success":
      return `Успех: ${res.data.join(", ")}`;
    case "error":
      return `Ошибка: ${res.message}`;
    case "loading":
      return "Загрузка...";
  }
}

console.log(handle({ status: "success", data: ["a", "b", "c"] }));
console.log(handle({ status: "error", message: "Что-то пошло не так" }));
console.log(handle({ status: "loading" }));
