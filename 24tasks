// 21. Queue<T>

console.log("\n=== 21. Queue ===");
class Queue<T> {
  private items: T[] = [];
  enqueue(item: T): void { this.items.push(item); }
  dequeue(): T | undefined { return this.items.shift(); }
  peek(): T | undefined { return this.items[0]; }
  size(): number { return this.items.length; }
}
const qn = new Queue<number>();
qn.enqueue(1); qn.enqueue(2); qn.enqueue(3);
console.log("Размер очереди чисел:", qn.size());
console.log("Первый элемент:", qn.peek());
console.log("Извлечён:", qn.dequeue());
console.log("Осталось:", qn.size());

const qs = new Queue<string>();
qs.enqueue("a"); qs.enqueue("b");
console.log("Очередь строк:", qs.dequeue(), qs.dequeue());


